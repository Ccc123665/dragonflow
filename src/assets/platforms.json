{
  "version": 1,
  "note": "平台定义。新增平台只需在此追加一项，并在 assets/adapters/ 下补一个同名 JS 适配脚本，无需改主程序。 rules 是发布前体检用的字段规则，数值为经验参考值，可直接改这里调整。",
  "platforms": [
    {
      "key": "xhs",
      "name": "小红书",
      "short": "红",
      "color": "#E0443A",
      "login_url": "https://creator.xiaohongshu.com/login",
      "home_url": "https://creator.xiaohongshu.com/",
      "publish_url": "https://creator.xiaohongshu.com/publish/publish?from=menu_left&target=image",
      "publish_url_video": "https://creator.xiaohongshu.com/publish/publish?from=menu_left&target=video",
      "upload_dir_field": "image_hint",
      "content_types": [
        "图文",
        "视频"
      ],
      "adapter": "xhs.js",
      "submit_confirm": true,
      "enabled": true,
      "order": 1,
      "rules": {
        "title": {
          "min": 6,
          "max": 20,
          "label": "标题"
        },
        "body": {
          "min": 60,
          "max": 1000,
          "label": "正文"
        },
        "topics": {
          "min": 3,
          "max": 10,
          "label": "话题标签"
        },
        "cover": {
          "max": 12,
          "label": "封面文案"
        },
        "images": {
          "min": 1,
          "max": 18,
          "label": "配图"
        },
        "ban_phrases": [
          "公众号",
          "微信",
          "加V",
          "加v",
          "私信我",
          "点击链接",
          "淘宝",
          "天猫"
        ],
        "ban_links": true
      }
    },
