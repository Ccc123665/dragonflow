        },
        "topics": {
          "min": 2,
          "max": 5,
          "label": "话题标签"
        },
        "ban_phrases": [
          "公众号",
          "加V",
          "加v",
          "私信我",
          "微信"
        ],
        "ban_links": true
      }
    },
